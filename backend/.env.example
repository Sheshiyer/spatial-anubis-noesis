# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/spatial_anubis
DATABASE_URL_SYNC=postgresql://user:password@localhost:5432/spatial_anubis

# JWT
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# World Labs API
WORLD_LABS_API_KEY=your-world-labs-api-key
WORLD_LABS_API_URL=https://api.worldlabs.ai/v1
WORLD_LABS_MOCK_MODE=true

# Rate Limiting
RATE_LIMIT_WORLD_GENERATION_PER_HOUR=1

# Asset Storage
ASSET_STORAGE_PATH=./storage/assets
FALLBACK_WORLDS_PATH=./storage/fallback_worlds

# CORS
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]

# Application
DEBUG=false
LOG_LEVEL=INFO
