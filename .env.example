# Environment Configuration Example
# Copy this file to .env for local development

# BFF (Backend-for-Frontend) API
VITE_BFF_API_URL=http://localhost:8000

# Selemene Calculation Engine
VITE_SELEMENE_API_URL=https://selemene.tryambakam.space

# PIP Analysis Engine
VITE_PIP_API_URL=http://localhost:8001

# World Labs API
VITE_WORLDLABS_API_KEY=your-worldlabs-api-key-here

# Feature Flags
VITE_ENABLE_MEDIAPIPE=true
VITE_ENABLE_PHYSICS_DEBUG=false
VITE_ENABLE_PERFORMANCE_MONITOR=true

# Performance Budgets
VITE_TARGET_FPS=60
VITE_MAX_SPLATS=500000
VITE_VRAM_BUDGET_MB=256
